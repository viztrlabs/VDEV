{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2020",
    "moduleResolution": "bundler",
    "paths": {
      "playcanvas": ["./node_modules/playcanvas"]
    },
    "lib": ["es2022", "dom", "WebWorker"],
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "inlineSources": true,
    "resolveJsonModule": true,
    "jsx": "preserve"
  },
  "include": [
    "./src/splat-editor/**/*.ts",
    "./global.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".next"
  ]
}