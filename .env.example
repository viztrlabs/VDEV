# ---------------------------------------------------------------------------
# Messaging / social connectors (provider-agnostic agent layer)
# ---------------------------------------------------------------------------
# Telegram (free, official Bot API — activate first):
#   1. Talk to @BotFather on Telegram → /newbot → copy the token.
#   2. Register the webhook with a public HTTPS URL, e.g.:
#        curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#             -d "url=https://your-domain/api/messaging/telegram"
#   3. Optionally add ?secret_token=<TELEGRAM_WEBHOOK_SECRET> for verification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=Viztr_bot
# Private supergroup for website-visitor human handoff (must be a forum supergroup).
# @viztr_bot must be an Admin with "Manage Topics"; Group Privacy must be OFF.
TELEGRAM_SUPPORT_GROUP_ID=-1004419719289
NEXT_PUBLIC_SITE_URL=https://viztr.in

