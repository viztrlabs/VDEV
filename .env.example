# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL database connection string for Prisma ORM
DATABASE_URL="postgresql://user:password@localhost:5432/viztr_db?schema=public"

# NEXTAUTH AUTHENTICATION
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-jwt-token-viztr-2026"

# GOOGLE OAUTH CREDENTIALS (WORKSPACE SSO)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# REDIS CACHING & CLUSTER SESSIONS
REDIS_URL="redis://localhost:6379"

# CLOUDFLARE R2 OBJECT STORAGE (3D GLB & 8K ASSETS)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="viztr-spatial-assets"

# SUPABASE (OPTIONAL REALTIME SYNC)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
