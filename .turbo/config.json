{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    }
  },
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_APP_URL"],
  "globalDependencies": ["global-env"],
  "semiManagedCache": true
}