# ============================================================================
# VizTR Production Environment Variables
# ============================================================================
# Copy to .env.local for local dev, or set in Vercel/hosting dashboard.
# Items marked [REQUIRED] must be set before deployment.
# ============================================================================

# --- NextAuth [REQUIRED] ---
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=          # Generate: openssl rand -base64 32

# --- Supabase [REQUIRED] ---
NEXT_PUBLIC_SUPABASE_URL=https://naludjmicbqcagrlsrba.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # From Supabase Dashboard → Settings → API
SUPABASE_SERVICE_ROLE_KEY=       # From Supabase Dashboard → Settings → API (keep secret!)

# --- Client Portal [REQUIRED] ---
CLIENT_PORTAL_SECRET=     # Generate: openssl rand -base64 32

# --- Pixel Streaming (post-launch) ---
PS_URL=wss://your-sfu.example.com
PS_APP_ID=
PS_API_KEY=
PS_TURN_URL=
PS_TURN_USER=
PS_TURN_PASS=            # REMOVED from API response — server-side only

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Engine Config (optional) ---
NEXT_PUBLIC_ENGINE=three  # 'three' or 'playcanvas'

# --- Google Analytics (optional) ---
NEXT_PUBLIC_GA_ID=

# --- App Metadata ---
NEXT_PUBLIC_APP_NAME=VizTR
NEXT_PUBLIC_APP_URL=https://your-domain.com
