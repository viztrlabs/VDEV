# =============================================================================
# VizTR Editor Server (.env.local)
# =============================================================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
#
# ROTATION SCHEDULE:
# - SUPABASE_SERVICE_ROLE_KEY: Rotate quarterly or after any key compromise
# - NEXTAUTH_SECRET: Rotate quarterly
# - GEMINI_API_KEY: Rotate quarterly
# - GOOGLE_CLIENT_SECRET: Rotate when Google Console credentials change
# - PS_TURN_PASS: Rotate quarterly
# =============================================================================

# Pixel Streaming
NEXT_PUBLIC_PS_SIGNALING_URL=wss://stream.viztr.io
PS_TURN_URL=turn:turn.viztr.io:3478
PS_TURN_USER=viztr
PS_TURN_PASS=<rotate-quarterly>

# UE5 streaming fallback
NEXT_PUBLIC_PS_FALLBACK_IMAGE=https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=2400&q=95

# Hermes live LLM (rotate quarterly)
GEMINI_API_KEY=<rotate-quarterly>

# Supabase
NEXT_PUBLIC_SUPABASE_URL=<your-supabase-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
# SECURITY: Service-role key should only be loaded by trusted server code
SUPABASE_SERVICE_ROLE_KEY=<rotate-quarterly>

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<rotate-quarterly-use-strong-random>

# Editor dev bypass (ONLY for local development — never set in production)
# When set to 'true' AND NODE_ENV !== 'production', allows unauthenticated
# access with a hardcoded dev-user identity. Remove entirely for production.
# EDITOR_DEV_BYPASS=true

# Google OAuth (rotate when changing Google Console credentials)
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<rotate-when-changed>
