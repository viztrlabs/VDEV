{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:component": "jest --testPathPattern=__tests__",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "openapi:generate": "tsx scripts/generate-openapi.ts > openapi.json",
    "bundle:analyze": "ANALYZE=true next build",
    "collab": "node scripts/collab-server.mjs",
    "demo": "next build && next start -p 3000",
    "demo:dev": "next dev -p 3000",
    "build:splat-editor": "rollup -c rollup.config.splat.mjs",
    "watch:splat-editor": "rollup -c rollup.config.splat.mjs -w",
    "dev:next": "next dev",
    "dev:engine": "node forks/editor/server/index.js",
    "dev:splatserv": "node forks/supersplat/server.js",
    "dev:whatsapp": "node scripts/dev-whatsapp-bot.mjs",
    "dev:telegram": "node scripts/dev-telegram-bot.mjs",
    "dev:all": "concurrently --kill-others-on-fail --prefix-colors cyan,green,magenta,yellow,blue --prefix '[{name}]' --names 'NEXT,ENGINE,SPLAT,WHATSAPP,TELEGRAM' \"pnpm run dev:next\" \"pnpm run dev:engine\" \"pnpm run dev:splatserv\" \"pnpm run dev:whatsapp\" \"pnpm run dev:telegram\"",
    "dev:all:ps": "powershell -ExecutionPolicy Bypass -File scripts/dev-all.ps1",
    "kill:all": "powershell -ExecutionPolicy Bypass -File scripts/kill-all.ps1",
    "kill:all:bat": "scripts/kill-all.bat",
    "telegram:register-commands": "tsx scripts/register-telegram-commands.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
