datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  CLIENT
}

enum ProjectStatus {
  BRIEF_RECEIVED
  IN_PRODUCTION
  DRAFT_READY
  CLIENT_REVIEW
  REVISIONS
  FINAL_DELIVERY
  COMPLETED
}

enum ServiceCategory {
  STUDIO
  XR_WORLD
}

enum PortfolioCategory {
  EXTERIOR
  INTERIOR
  ANIMATION
  XR
  PANORAMA_360
  WALKTHROUGH
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  password      String?
  role          Role            @default(USER)
  avatar        String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]
  blogPosts     BlogPost[]
  mediaAssets   MediaAsset[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id           String    @id @default(cuid())
  name         String
  company      String
  email        String    @unique
  phone        String?
  accessKey    String?   @unique
  projects     Project[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Project {
  id                   String            @id @default(cuid())
  name                 String
  slug                 String            @unique
  status               ProjectStatus     @default(BRIEF_RECEIVED)
  progress             Int               @default(0)
  serviceCategory      String
  clientName           String
  clientEmail          String
  clientId             String?
  client               Client?           @relation(fields: [clientId], references: [id])
  startDate            DateTime?
  deliveryDate         DateTime?
  description          String?           @db.Text
  visibility           Boolean           @default(true)
  assets               ProjectAsset[]
  updates              ProjectUpdate[]
  models3D             Model3D[]
  panoramas            Panorama[]
  pixelStreamSessions  PixelStreamSession[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model ProjectAsset {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String
  url         String
  sizeBytes   BigInt?
  resolution  String?
  isWatermarked Boolean @default(false)
  createdAt   DateTime @default(now())
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       ProjectStatus
  message     String   @db.Text
  authorName  String
  createdAt   DateTime @default(now())
}

model Service {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  category    ServiceCategory
  description String          @db.Text
  icon        String?
  image       String?
  visible     Boolean         @default(true)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model PortfolioItem {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  featuredImage    String
  galleryImages    String[]
  videoUrl         String?
  panoramaUrl      String?
  model3dUrl       String?
  category         PortfolioCategory
  tags             String[]
  clientName       String?
  location         String?
  shortDescription String?           @db.Text
  longDescription  String?           @db.Text
  featured         Boolean           @default(false)
  metaTitle        String?
  metaDescription  String?
  ogImage          String?
  canonical        String?
  noIndex          Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model BlogPost {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  content         String      @db.Text
  excerpt         String?     @db.Text
  featuredImage   String?
  authorId        String
  author          User        @relation(fields: [authorId], references: [id])
  category        String
  tags            String[]
  status          BlogStatus  @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  canonical       String?
  noIndex         Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  type      String
  createdAt DateTime @default(now())
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  role      String
  firm      String
  quote     String   @db.Text
  rating    Int      @default(5)
  avatar    String?
  featured  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MediaAsset {
  id          String   @id @default(cuid())
  name        String
  type        String
  url         String
  size        Int
  altText     String?
  folder      String   @default("root")
  uploadedById String?
  uploadedBy  User?    @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now())
}

model Model3D {
  id           String   @id @default(cuid())
  name         String
  url          String
  format       String
  size         Int
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  previewImage String?
  dracoCompressed Boolean @default(true)
  webXREnabled Boolean  @default(true)
  arEnabled    Boolean  @default(true)
  vrEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Panorama {
  id               String   @id @default(cuid())
  name             String
  imageUrl         String
  hotspots         Json     @default("[]")
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id])
  gyroscopeEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model XRLink {
  id          String   @id @default(cuid())
  title       String
  token       String   @unique
  targetUrl   String
  viewsCount  Int      @default(0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
}

model PixelStreamSession {
  id           String   @id @default(cuid())
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  signalingUrl String
  gpuNodeId    String?
  status       String   @default("IDLE")
  fps          Int      @default(60)
  latencyMs    Float    @default(15.0)
  startedAt    DateTime @default(now())
  endedAt      DateTime?
}

model FormSubmission {
  id        String    @id @default(cuid())
  type      String
  data      Json
  status    String    @default("UNREAD")
  readAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())
}

model Booking {
  id            String    @id @default(cuid())
  name          String
  email         String
  phone         String
  company       String?
  service       String
  preferredDate DateTime
  preferredTime String
  budgetRange   String?
  details       String    @db.Text
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  source      String
  status      String   @default("NEW")
  dealValue   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NavigationMenu {
  id        String   @id @default(cuid())
  title     String
  location  String   @default("header")
  items     Json
  createdAt DateTime @default(now())
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  isDefault   Boolean  @default(false)
  colors      Json
  typography  Json
  createdAt   DateTime @default(now())
}

model DesignSettings {
  id              String   @id @default(cuid())
  primaryColor    String   @default("#3ECF8E")
  secondaryColor  String   @default("#18181B")
  fontDisplay     String   @default("Space Grotesk")
  fontMono        String   @default("JetBrains Mono")
  updatedAt       DateTime @updatedAt
}

model SEOSettings {
  id              String   @id @default(cuid())
  pagePath        String   @unique
  metaTitle       String
  metaDescription String
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  properties Json?
  timestamp  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String?
  details   Json?
  timestamp DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model PricingPlan {
  id          String   @id @default(cuid())
  name        String
  tier        String
  price       String
  deliverables String[]
  popular     Boolean  @default(false)
  createdAt   DateTime @default(now())
}
